index 0e0c926..4084425 100644
--- a/lib/ivis_opengl/tex.c
+++ b/lib/ivis_opengl/tex.c
@@ -36,6 +36,8 @@
 #include "lib/ivis_common/png_util.h"
 
 #include "screen.h"
