 lib/ivis_opengl/screen.c |  8 ++---
 lib/ivis_opengl/tex.c    | 68 +++++++++++++++++++++++++++++++++-------
 src/texture.c            | 12 +------
 4 files changed, 65 insertions(+), 26 deletions(-)

