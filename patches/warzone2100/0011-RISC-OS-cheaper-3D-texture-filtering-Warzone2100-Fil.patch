-		glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, MIN(4.0f, max));
-	}
+	pie_Set3DTextureFilter();
 
 	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP);
 	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP);
@@ -315,3 +307,57 @@ unsigned int iV_getPixelFormat(const iV_Image *image)
 			return GL_INVALID_ENUM;
 	}
 }
+
+
+/*!
+ * Filtering for mipmapped 3D textures. Upstream uses trilinear filtering
+ * with 4x anisotropy; with software OpenGL (RISC OS) anisotropic sampling
+ * alone costs several trilinear lookups per pixel, so there the variable
+ * Warzone2100$Filter picks one of:
+ *   best    - upstream: trilinear + 4x anisotropic
+ *   smooth  - trilinear (GL_LINEAR_MIPMAP_LINEAR), no anisotropy
+ *   fast    - bilinear, nearest mipmap level (GL_LINEAR_MIPMAP_NEAREST): default
+ *   nearest - no filtering (GL_NEAREST_MIPMAP_NEAREST / GL_NEAREST): fastest
+ */
+void pie_Set3DTextureFilter(void)
+{
+	GLint minFilter = GL_LINEAR_MIPMAP_LINEAR, magFilter = GL_LINEAR;
+	bool anisotropic = true;
+
+#if defined(WZ_OS_RISCOS)
+	static int mode = -1;	// 0 best, 1 smooth, 2 fast, 3 nearest
+
+	if (mode < 0)
+	{
+		const char *v = getenv("Warzone2100$Filter");
+
+		mode = 2;
+		if (v && strcasecmp(v, "best") == 0)         mode = 0;
+		else if (v && strcasecmp(v, "smooth") == 0)  mode = 1;
+		else if (v && strcasecmp(v, "nearest") == 0) mode = 3;
+		debug(LOG_TEXTURE, "3D texture filter mode %d", mode);
+	}
+	anisotropic = (mode == 0);
+	if (mode == 2)
+	{
+		minFilter = GL_LINEAR_MIPMAP_NEAREST;
+	}
+	else if (mode == 3)
+	{
+		minFilter = GL_NEAREST_MIPMAP_NEAREST;
+		magFilter = GL_NEAREST;
+	}
+#endif
+
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, minFilter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, magFilter);
+
+	// Use anisotropic filtering, if available, but only max 4.0 to reduce processor burden
+	if (anisotropic && GLEE_EXT_texture_filter_anisotropic)
+	{
+		GLfloat max;
+
+		glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &max);
+		glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, MIN(4.0f, max));
+	}
+}
