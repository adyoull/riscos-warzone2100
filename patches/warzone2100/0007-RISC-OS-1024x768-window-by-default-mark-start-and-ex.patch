From a05f21fa87d78e54b6bd07355e7bf9ec263296ae Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:29:54 +0100
Subject: [PATCH] RISC OS: 1024x768 window by default; mark start and exit in
 the log

With no size in the config the game opened a window the size of the
desktop (upstream uses the desktop mode). On RISC OS a desktop window now
starts at 1024x768 (640x480 on small screens); full screen is unchanged.

The log is empty in a normal run, which made an empty log after a crash
ambiguous: it now says when the game starts, when SDL_QUIT arrives and
when exit() runs.
---
 lib/ivis_opengl/screen.c | 18 ++++++++++++++++++
 src/main.c               | 18 ++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/lib/ivis_opengl/screen.c b/lib/ivis_opengl/screen.c
index 8a602d3..a811046 100644
--- a/lib/ivis_opengl/screen.c
+++ b/lib/ivis_opengl/screen.c
@@ -92,6 +92,24 @@ bool screenInitialise(
 		desktop.format = SDL_PIXELFORMAT_RGB888;
 	}
 
+#if defined(WZ_OS_RISCOS)
+	// No size in the config yet: a desktop-sized window is far too slow for
+	// software OpenGL and hides the desktop. Start at 1024x768 (or 640x480
+	// on a small screen); full screen still uses the desktop size.
+	if ((width == 0 || height == 0) && !fullScreen)
+	{
+		if (desktop.w > 1024 && desktop.h > 768)
+		{
+			desktop.w = 1024;
+			desktop.h = 768;
+		}
+		else
+		{
+			desktop.w = 640;
+			desktop.h = 480;
+		}
+	}
+#endif
 	if (width == 0 || height == 0)
 	{
 		pie_SetVideoBufferWidth(width = screenWidth = desktop.w);
diff --git a/src/main.c b/src/main.c
index 07fac08..9f79839 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1019,6 +1019,9 @@ static void mainLoop(void)
 					handleActiveEvent(&event.window);
 					break;
 				case SDL_QUIT:
+#if defined(WZ_OS_RISCOS)
+					fprintf(stderr, "Warzone 2100: quit requested (SDL_QUIT)\n");
+#endif
 					saveConfig();
 					return;
 				default:
@@ -1057,12 +1060,27 @@ static void mainLoop(void)
 }
 
 
+#if defined(WZ_OS_RISCOS)
+/* The log (<Wimp$ScrapDir>.Warzone2100log) is empty when all is well, so
+   mark start and exit: a log with the first line but not the second means
+   the program was stopped from outside (an error box, or a crash UnixLib
+   couldn't report). */
+static void riscos_log_exit(void)
+{
+	fprintf(stderr, "Warzone 2100: exit() called, shutting down\n");
+}
+#endif
+
 int main(int argc, char *argv[])
 {
 	setupExceptionHandler(argc, argv);
 
 	debug_init();
 	debug_register_callback( debug_callback_stderr, NULL, NULL, NULL );
+#if defined(WZ_OS_RISCOS)
+	fprintf(stderr, "Warzone 2100 %s (RISC OS) started\n", PACKAGE_VERSION);
+	atexit(riscos_log_exit);
+#endif
 #if defined(WZ_OS_WIN) && defined(DEBUG_INSANE)
 	debug_register_callback( debug_callback_win32debug, NULL, NULL, NULL );
 #endif // WZ_OS_WIN && DEBUG_INSANE
-- 
