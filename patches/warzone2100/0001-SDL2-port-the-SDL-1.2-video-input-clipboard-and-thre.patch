+/*!
+ * Handle text input (SDL2): one buffer entry per character, keyed like
+ * SDL 1.2 did (the unshifted ASCII key where there is one).
+ */
+void inputHandleTextEvent(SDL_TextInputEvent * textEvent)
+{
+	const unsigned char *p = (const unsigned char *)textEvent->text;
+
+	while (*p)
+	{
+		utf_32_char c;
+		UDWORD key;
+		int extra = 0;
+
+		if (*p < 0x80)       { c = *p; }
+		else if (*p < 0xE0)  { c = *p & 0x1F; extra = 1; }
+		else if (*p < 0xF0)  { c = *p & 0x0F; extra = 2; }
+		else                 { c = *p & 0x07; extra = 3; }
+		p++;
+		while (extra-- > 0 && (*p & 0xC0) == 0x80)
+		{
+			c = (c << 6) | (*p++ & 0x3F);
+		}
+		if (c < 32)
+		{
+			continue;
+		}
+		key = (c < 128) ? (UDWORD)((c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c) : 0;
+		inputAddBuffer(key, c);
+	}
+}
