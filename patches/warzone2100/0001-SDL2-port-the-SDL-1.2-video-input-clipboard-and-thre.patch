+int screenGetModes(Vector2i *modes, int max)
+{
+	// SDL2 lists the display's real modes, but a window can be any size and
+	// RISC OS drivers often report only the current mode, so offer the usual
+	// sizes up to the desktop size, plus the desktop size itself.
+	static const Vector2i common[] =
+	{
+		{640, 480}, {800, 600}, {1024, 768}, {1152, 864}, {1280, 720}, {1280, 800},
+		{1280, 1024}, {1366, 768}, {1440, 900}, {1600, 900}, {1600, 1200},
+		{1680, 1050}, {1920, 1080}, {1920, 1200}, {2560, 1440},
+	};
+	SDL_DisplayMode desktop;
+	int n = 0, i;
+	bool haveDesktop = false;
+
+	if (SDL_GetDesktopDisplayMode(0, &desktop) != 0)
+	{
+		desktop.w = 1920;
+		desktop.h = 1200;
+	}
+	for (i = 0; i < (int)(sizeof(common) / sizeof(common[0])) && n < max; i++)
+	{
+		if (common[i].x <= desktop.w && common[i].y <= desktop.h)
+		{
+			modes[n++] = common[i];
+			haveDesktop |= (common[i].x == desktop.w && common[i].y == desktop.h);
+		}
+	}
+	if (!haveDesktop && n < max && desktop.w >= 640 && desktop.h >= 480)
+	{
+		modes[n].x = desktop.w;
+		modes[n].y = desktop.h;
+		n++;
+	}
+	return n;
 }
 
