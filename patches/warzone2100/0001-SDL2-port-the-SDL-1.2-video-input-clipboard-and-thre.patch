 				|| aMouseState[buttonEvent->button].state == KEY_PRESSRELEASE )
 			{
-				if ( (buttonEvent->button != SDL_BUTTON_WHEELUP		//skip doubleclick check for wheel
-					&& buttonEvent->button != SDL_BUTTON_WHEELDOWN))
+				if ( (buttonEvent->button != MOUSE_WUP		//skip doubleclick check for wheel
+					&& buttonEvent->button != MOUSE_WDN))
 				{
 				//whether double click or not
 					if ( gameTime2 - aMouseState[buttonEvent->button].lastdown < DOUBLE_CLICK_INTERVAL )
@@ -381,6 +476,35 @@ void inputHandleMouseButtonEvent(SDL_MouseButtonEvent * buttonEvent)
 }
 
 
+/*!
+ * Handle mouse wheel events (SDL2): SDL 1.2 reported the wheel as buttons 4
+ * (up) and 5 (down), pressed and released at once; do the same.
+ */
+void inputHandleMouseWheelEvent(SDL_MouseWheelEvent * wheelEvent)
+{
+	SDL_MouseButtonEvent b;
+	int clicks = wheelEvent->y;
+
+	if (wheelEvent->direction == SDL_MOUSEWHEEL_FLIPPED)
+	{
+		clicks = -clicks;
+	}
+	memset(&b, 0, sizeof(b));
+	b.which = (Uint32)-2;     // marks our own synthetic wheel "button"
+	b.x = mouseXPos;
+	b.y = mouseYPos;
+	b.button = clicks > 0 ? MOUSE_WUP : MOUSE_WDN;
+	if (clicks == 0)
+	{
+		return;
+	}
+	b.type = SDL_MOUSEBUTTONDOWN;
+	inputHandleMouseButtonEvent(&b);
+	b.type = SDL_MOUSEBUTTONUP;
+	inputHandleMouseButtonEvent(&b);
+}
