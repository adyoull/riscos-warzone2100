+/** SDL2 keycode -> Warzone key code (SDL 1.2 value); KEY_MAXSCAN if unknown. */
+static unsigned int sdl2KeyToKeyCode(SDL_Keycode key)
+{
+	unsigned int i;
+
+	if (key >= 0 && key < 128)
+	{
+		return key;
+	}
+	for (i = 0; i < sizeof(keyMap) / sizeof(keyMap[0]); i++)
+	{
+		if (keyMap[i].sdl2 == key)
+		{
+			return keyMap[i].code;
+		}
+	}
+	return KEY_MAXSCAN;
+}
+
+/** Warzone key code -> SDL2 keycode (SDLK_UNKNOWN if none). */
+static SDL_Keycode keyCodeToSDL2Key(unsigned int code)
+{
+	unsigned int i;
+
+	if (code < 128)
+	{
+		return code;
+	}
+	for (i = 0; i < sizeof(keyMap) / sizeof(keyMap[0]); i++)
+	{
+		if (keyMap[i].code == (int)code)
+		{
+			return keyMap[i].sdl2;
+		}
+	}
+	return SDLK_UNKNOWN;
 }
 
