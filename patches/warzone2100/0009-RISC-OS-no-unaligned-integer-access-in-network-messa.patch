From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:47:54 +0100
Subject: [PATCH 09/11] RISC OS: no unaligned integer access in network
 messages

NETMSG.body starts at an odd offset (after a uint16_t and three bytes), so
NETint16_t/NETuint16_t/NETint32_t/NETuint32_t stored and loaded unaligned
integers, and NETsendGAMESTRUCT/NETrecvGAMESTRUCT and NET_recvMessage did
the same in their buffers. RISC OS traps unaligned accesses: starting a
skirmish stopped with an "EMT trap" in setMultiStats.

endian_hack.h gets wz_load_u16/s16/u32/s32/float and wz_store_* (memcpy,
so byte accesses), and the network code uses them. The wire format
doesn't change.
---
 lib/framework/endian_hack.h | 18 ++++++++++
 lib/netplay/netplay.c       | 68 ++++++++++++++++++++-----------------
 lib/netplay/nettypes.c      | 33 +++++++++++-------
 3 files changed, 75 insertions(+), 44 deletions(-)

diff --git a/lib/framework/endian_hack.h b/lib/framework/endian_hack.h
index 69ac88a..81d3288 100644
--- a/lib/framework/endian_hack.h
+++ b/lib/framework/endian_hack.h
@@ -89,4 +89,22 @@ static inline void endian_sdword(SDWORD* sdword)
 #endif
 }
 
+/* Loads and stores at addresses that may not be aligned: values inside
+ * file, save-game and network buffers. ARM Linux and x86 tolerate unaligned
+ * 16/32-bit accesses; RISC OS traps them ("abort on data transfer"), so go
+ * through memcpy, which the compiler turns into byte accesses. The byte
+ * order is unchanged (use the endian_ and SDL_Swap functions for that). */
+#include <string.h>
+
+static inline uint16_t wz_load_u16(const void *p) { uint16_t v; memcpy(&v, p, sizeof(v)); return v; }
+static inline int16_t  wz_load_s16(const void *p) { int16_t  v; memcpy(&v, p, sizeof(v)); return v; }
+static inline uint32_t wz_load_u32(const void *p) { uint32_t v; memcpy(&v, p, sizeof(v)); return v; }
+static inline int32_t  wz_load_s32(const void *p) { int32_t  v; memcpy(&v, p, sizeof(v)); return v; }
+static inline float    wz_load_float(const void *p) { float v; memcpy(&v, p, sizeof(v)); return v; }
+
+static inline void wz_store_u16(void *p, uint16_t v) { memcpy(p, &v, sizeof(v)); }
+static inline void wz_store_s16(void *p, int16_t v)  { memcpy(p, &v, sizeof(v)); }
+static inline void wz_store_u32(void *p, uint32_t v) { memcpy(p, &v, sizeof(v)); }
+static inline void wz_store_s32(void *p, int32_t v)  { memcpy(p, &v, sizeof(v)); }
+
 #endif // ENDIAN_HACK_H
