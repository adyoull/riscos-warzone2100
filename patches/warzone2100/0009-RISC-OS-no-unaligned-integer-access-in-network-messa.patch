-	*(uint32_t*)buffer = htonl(ourgamestruct->privateGame);
+	{ uint32_t wz_v = htonl(ourgamestruct->privateGame); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->pureGame);
+	{ uint32_t wz_v = htonl(ourgamestruct->pureGame); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->Mods);
+	{ uint32_t wz_v = htonl(ourgamestruct->Mods); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->gameId);
+	{ uint32_t wz_v = htonl(ourgamestruct->gameId); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->future2);
+	{ uint32_t wz_v = htonl(ourgamestruct->future2); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->future3);
+	{ uint32_t wz_v = htonl(ourgamestruct->future3); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->future4);
+	{ uint32_t wz_v = htonl(ourgamestruct->future4); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 
@@ -1967,16 +1971,16 @@ static bool NETrecvGAMESTRUCT(GAMESTRUCT* ourgamestruct)
 
 	// Now dump the data into the game struct
 	// Copy 32bit large big endian numbers
-	ourgamestruct->GAMESTRUCT_VERSION = ntohl(*(uint32_t*)buffer);
+	{ uint32_t wz_v; memcpy(&wz_v, buffer, sizeof(wz_v)); ourgamestruct->GAMESTRUCT_VERSION = ntohl(wz_v); }
 	buffer += sizeof(uint32_t);
 	// Copy a string
 	sstrcpy(ourgamestruct->name, buffer);
 	buffer += sizeof(ourgamestruct->name);
 
 	// Copy 32bit large big endian numbers
