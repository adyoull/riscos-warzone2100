From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:04:14 +0100
Subject: [PATCH 09/11] RISC OS: no unaligned integer access in network
 messages

NETMSG.body starts at an odd offset (after a uint16_t and three bytes), so
NETint16_t/NETuint16_t/NETint32_t/NETuint32_t stored and loaded unaligned
integers, and NETsendGAMESTRUCT/NETrecvGAMESTRUCT did the same in their
buffers. RISC OS traps unaligned accesses: starting a skirmish stopped
with an "EMT trap" in setMultiStats. They now copy the bytes with memcpy;
the wire format doesn't change.
---
 lib/netplay/netplay.c  | 68 ++++++++++++++++++++++--------------------
 lib/netplay/nettypes.c | 44 +++++++++++++++++++--------
 2 files changed, 68 insertions(+), 44 deletions(-)

diff --git a/lib/netplay/netplay.c b/lib/netplay/netplay.c
index 7178088..59b7944 100644
--- a/lib/netplay/netplay.c
+++ b/lib/netplay/netplay.c
@@ -1413,7 +1413,11 @@ static BOOL NET_recvMessage(NETBUFSOCKET* bs)
 		goto error;
 	}
 
-	size = ntohs(message->size) + headersize;
+	// message may be at an odd address in the buffer (RISC OS traps
+	// unaligned accesses): read its 16-bit size byte-wise.
+	uint16_t wz_size;
+	memcpy(&wz_size, &message->size, sizeof(wz_size));
+	size = ntohs(wz_size) + headersize;
 
 	if (size > bs->bytes)
 	{
@@ -1421,7 +1425,7 @@ static BOOL NET_recvMessage(NETBUFSOCKET* bs)
 	}
 
 	memcpy(pMsg, message, size);
-	pMsg->size = ntohs(message->size);
+	pMsg->size = ntohs(wz_size);
 	bs->buffer_start += size;
 	bs->bytes -= size;
 
@@ -1797,7 +1801,7 @@ static bool NETsendGAMESTRUCT(Socket* sock, const GAMESTRUCT* ourgamestruct)
 
 	// Now dump the data into the buffer
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->GAMESTRUCT_VERSION);
+	{ uint32_t wz_v = htonl(ourgamestruct->GAMESTRUCT_VERSION); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
 	// Copy a string
@@ -1805,9 +1809,9 @@ static bool NETsendGAMESTRUCT(Socket* sock, const GAMESTRUCT* ourgamestruct)
 	buffer += sizeof(ourgamestruct->name);
 
 	// Copy 32bit large big endian numbers
-	*(int32_t*)buffer = htonl(ourgamestruct->desc.dwSize);
+	{ int32_t wz_v = htonl(ourgamestruct->desc.dwSize); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(int32_t);
-	*(int32_t*)buffer = htonl(ourgamestruct->desc.dwFlags);
+	{ int32_t wz_v = htonl(ourgamestruct->desc.dwFlags); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(int32_t);
 
 	// Copy yet another string
@@ -1815,13 +1819,13 @@ static bool NETsendGAMESTRUCT(Socket* sock, const GAMESTRUCT* ourgamestruct)
 	buffer += sizeof(ourgamestruct->desc.host);
 
