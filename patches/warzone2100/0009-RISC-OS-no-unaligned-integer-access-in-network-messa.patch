+++ b/lib/netplay/nettypes.c
@@ -156,7 +156,10 @@ BOOL NETuint8_t(uint8_t *ip)
 
 BOOL NETint16_t(int16_t *ip)
 {
-	int16_t *store = (int16_t *) &NetMsg.body[NetMsg.size];
+	// NetMsg.body is at an odd offset, so the value may be unaligned
+	// (RISC OS traps unaligned accesses): copy it byte-wise.
+	char *store = &NetMsg.body[NetMsg.size];
+	int16_t value;
 
 	// Make sure there is enough data/space left in the packet
 	if (sizeof(int16_t) + NetMsg.size > sizeof(NetMsg.body) || !NetMsg.status)
@@ -167,11 +170,13 @@ BOOL NETint16_t(int16_t *ip)
 	// Convert the integer into the network byte order (big endian)
 	if (NETgetPacketDir() == PACKET_ENCODE)
 	{
-		*store = SDL_SwapBE16(*ip);
+		value = SDL_SwapBE16(*ip);
+		memcpy(store, &value, sizeof(value));
 	}
 	else if (NETgetPacketDir() == PACKET_DECODE)
 	{
-		*ip = SDL_SwapBE16(*store);
+		memcpy(&value, store, sizeof(value));
+		*ip = SDL_SwapBE16(value);
 	}
 
 	// Increment the size of the message
@@ -182,7 +187,10 @@ BOOL NETint16_t(int16_t *ip)
 
