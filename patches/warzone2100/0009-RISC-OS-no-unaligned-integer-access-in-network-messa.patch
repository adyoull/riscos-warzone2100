-	*(int32_t*)buffer = htonl(ourgamestruct->desc.dwMaxPlayers);
+	{ int32_t wz_v = htonl(ourgamestruct->desc.dwMaxPlayers); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(int32_t);
-	*(int32_t*)buffer = htonl(ourgamestruct->desc.dwCurrentPlayers);
+	{ int32_t wz_v = htonl(ourgamestruct->desc.dwCurrentPlayers); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(int32_t);
 	for (i = 0; i < ARRAY_SIZE(ourgamestruct->desc.dwUserFlags); ++i)
 	{
-		*(int32_t*)buffer = htonl(ourgamestruct->desc.dwUserFlags[i]);
+		{ int32_t wz_v = htonl(ourgamestruct->desc.dwUserFlags[i]); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 		buffer += sizeof(int32_t);
 	}
 
@@ -1853,39 +1857,39 @@ static bool NETsendGAMESTRUCT(Socket* sock, const GAMESTRUCT* ourgamestruct)
 	buffer += sizeof(ourgamestruct->modlist);
 
 	// Copy 32bit large big endian numbers
-	*(uint32_t*)buffer = htonl(ourgamestruct->game_version_major);
+	{ uint32_t wz_v = htonl(ourgamestruct->game_version_major); memcpy(buffer, &wz_v, sizeof(wz_v)); }
 	buffer += sizeof(uint32_t);
 
