From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:47:54 +0100
Subject: [PATCH 05/11] RISC OS: don't run programs through popen()/system()

UnixLib runs a child program as a *command inside our own memory, which
isn't safe from a large Wimp program.
- dumpinfo.cpp: at start-up the crash-dump code ran "which <argv[0]>" with
  popen(). On RISC OS that printed "File 'which' not found" and the game
  then stopped with an abort on data transfer. argv[0] is already the full
  path, so use it.
- frontend.c: the wz2100.net link starts URIdispatch with Wimp_StartTask.
---
 lib/exceptionhandler/dumpinfo.cpp | 5 +++++
 src/frontend.c                    | 9 +++++++++
 2 files changed, 14 insertions(+)

diff --git a/lib/exceptionhandler/dumpinfo.cpp b/lib/exceptionhandler/dumpinfo.cpp
index 73fbd9b..3cafd18 100644
--- a/lib/exceptionhandler/dumpinfo.cpp
+++ b/lib/exceptionhandler/dumpinfo.cpp
@@ -23,6 +23,7 @@
 #include <climits>
 #include <ctime>
 #include <string>
+#include <cstring>
 #include <vector>
 #include <deque>
 #include <sstream>
@@ -171,6 +172,10 @@ static std::string getProgramPath(const char* programCommand)
 	{
 		buf.resize(buf.size() * 2);
 	}
+#elif defined(WZ_OS_RISCOS)
+	/* No "which" on RISC OS, and popen() would try to run it as a *command
+	   ("File 'which' not found"). argv[0] is already the full path. */
+	buf.assign(programCommand, programCommand + strlen(programCommand));
 #elif defined(WZ_OS_UNIX) && !defined(WZ_OS_MAC)
 	{
 		FILE * whichProgramStream;
diff --git a/src/frontend.c b/src/frontend.c
index 91560a2..074046f 100644
--- a/src/frontend.c
+++ b/src/frontend.c
@@ -46,6 +46,10 @@
 #include "display.h"
 #include "frend.h"
 #include "frontend.h"
+
+#if defined(WZ_OS_RISCOS)
+#include <swis.h>
+#endif
 #include "hci.h"
 #include "init.h"
 #include "intdisplay.h"
@@ -125,6 +129,11 @@ static void runHyperlink(void)
 #elif defined (WZ_OS_MAC)
 	// For the macs
 	system("open http://wz2100.net");
+#elif defined(WZ_OS_RISCOS)
+	// RISC OS: hand the URL to whatever browser has claimed the URI
+	// protocol. Start it as a Wimp task, not with system(): UnixLib's
+	// system() runs the command as a child program inside our memory.
+	_swix(Wimp_StartTask, _IN(0), "URIdispatch http://wz2100.net/");
 #else
 	// for linux
 	system("xdg-open http://wz2100.net &");
