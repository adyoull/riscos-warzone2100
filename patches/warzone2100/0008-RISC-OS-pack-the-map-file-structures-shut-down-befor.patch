From f34b52c5173b61e20d8c69f65f597ff14c9cba05 Mon Sep 17 00:00:00 2001
From: Andrew Youll <adyoull@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:56:30 +0100
Subject: [PATCH] RISC OS: pack the map file structures; shut down before
 exit()

- map.c: map tiles are 3 bytes, so MAP_SAVETILE (a UWORD at odd
  addresses) and the gateway header after the tiles were read with
  unaligned ldrh/ldr. RISC OS traps those: loading any map (skirmish setup,
  the campaign) stopped with an "EMT trap" (abort on data transfer) in
  mapLoadV3. The three file structures are now packed, so they are read and
  written a byte at a time; the file format doesn't change.
- main.c: systemShutdown() ran from atexit(); joining the path-finding
  thread there made UnixLib abort (no thread switch is possible during
  exit()), so quitting the game ended in "Aborted". It now runs just before
  main() returns.
---
 src/main.c |  7 +++++++
 src/map.c  | 12 ++++++++----
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/main.c b/src/main.c
index 9f79839..986b89a 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1311,7 +1311,14 @@ int main(int argc, char *argv[])
 	debug_MEMSTATS();
 #endif
 
+#if defined(WZ_OS_RISCOS)
+	// Shut down now rather than from atexit(): UnixLib can't switch
+	// threads while exit() runs, so joining the path-finding thread there
+	// stopped the program with "Aborted".
+	systemShutdown();
+#else
 	atexit(systemShutdown);
+#endif
 	return EXIT_SUCCESS;
 }
 
diff --git a/src/map.c b/src/map.c
index 23c5153..ff86dee 100644
--- a/src/map.c
+++ b/src/map.c
@@ -60,7 +60,11 @@ struct ffnode
 //scroll min and max values
 SDWORD		scrollMinX, scrollMaxX, scrollMinY, scrollMaxY;
 
-/* Structure definitions for loading and saving map data */
+/* Structure definitions for loading and saving map data.
+ * The tiles are 3 bytes each, so the tile and gateway header structures
+ * after them are usually at unaligned addresses: they are packed so the
+ * compiler reads them a byte at a time (RISC OS traps unaligned halfword
+ * and word accesses: "abort on data transfer"). */
 typedef struct _map_save_header
 {
 	char		aFileType[4];
@@ -73,13 +77,13 @@ typedef struct _map_save_tilev2
 {
 	UWORD		texture;
 	UBYTE		height;
-} MAP_SAVETILE;
+} __attribute__((packed)) MAP_SAVETILE;
 
 typedef struct _gateway_save_header
 {
 	UDWORD		version;
 	UDWORD		numGateways;
-} GATEWAY_SAVEHEADER;
+} __attribute__((packed)) GATEWAY_SAVEHEADER;
 
 typedef struct _gateway_save
 {
@@ -91,7 +95,7 @@ typedef struct _zonemap_save_header {
 	UWORD numZones;
 	UWORD numEquivZones;
 	UWORD pad;
-} ZONEMAP_SAVEHEADER;
+} __attribute__((packed)) ZONEMAP_SAVEHEADER;
 
 /* Sanity check definitions for the save struct file sizes */
 #define SAVE_HEADER_SIZE	16
-- 
2.43.0

