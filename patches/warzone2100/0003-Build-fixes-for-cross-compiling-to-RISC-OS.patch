diff --git a/configure.ac b/configure.ac
index 388cffb..40b1eaa 100644
--- a/configure.ac
+++ b/configure.ac
@@ -87,8 +87,8 @@ case ${CC} in
 esac
 
 
-# Check for operating system
-case ${host_os} in
+# Check for operating system (the whole triplet: RISC OS is arm-riscos-gnueabihf)
+case ${host} in
 	*mingw32*)
 		host_os_mingw32=yes
 		AC_CHECK_TOOL([WINDRES], [windres], AC_MSG_ERROR([windres not found]))
@@ -204,7 +204,10 @@ AC_ARG_ENABLE([static],
 if test "x$enable_static" = "xyes" ; then
 	# Add libs where even pkg-config cannot help statically linking them,
 	# where one would otherwise have to provide them via commandline
-	WIN32_LIBS="${WIN32_LIBS} -lz -lintl -liconv"
+	if test "x$host_os_riscos" != "xyes" ; then
+		WIN32_LIBS="${WIN32_LIBS} -lz -lintl -liconv"
+	fi
+	# (RISC OS: UnixLib has iconv built in, and NLS is off)
 	# Tell pkg-config to link against static libraries, incl. all dependencies
 	PKG_CONFIG="${PKG_CONFIG} --static"
 fi
