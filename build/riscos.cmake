# CMake toolchain file for GCCSDK GCC 10 (arm-riscos-gnueabihf). Uses the
# environment from build/env.sh (GCCSDK_ENV, STAGE).
SET(CMAKE_SYSTEM_NAME GNU)          # as GCCSDK's own toolchain file: makes UNIX true
SET(CMAKE_SYSTEM_VERSION 1)
SET(CMAKE_SYSTEM_PROCESSOR arm)
SET(CMAKE_C_COMPILER   $ENV{GCCSDK_ENV}/bin/arm-riscos-gnueabihf-gcc)
SET(CMAKE_CXX_COMPILER $ENV{GCCSDK_ENV}/bin/arm-riscos-gnueabihf-g++)
SET(CMAKE_FIND_ROOT_PATH $ENV{STAGE} $ENV{GCCSDK_ENV})
SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
SET(BUILD_SHARED_LIBS OFF)
